# Copy to .env and fill in. Nothing here is required to run in mock mode.

# --- LLM --------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ORION_LLM_PROVIDER=mock          # mock | openai
ORION_MODEL=gpt-4o-mini
ORION_TEMPERATURE=0.0
ORION_SEED=7

# --- Retrieval --------------------------------------------------------------
ORION_RETRIEVAL=keyword          # keyword | embedding
ORION_MAX_CHUNKS=8

# --- Delivery ---------------------------------------------------------------
ORION_EMIT_DRY_RUN=true
# ORION_REVIEW_API_URL=https://review.orion.example/api/v1/assessments
# ORION_REVIEW_API_TOKEN=...
